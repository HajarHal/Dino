# Copier ce fichier en .env puis renseigner la clé.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OpenAI-compatible API (defaults to OpenRouter; set LLM_BASE_URL for another endpoint)
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_VISION_MODEL=google/gemini-2.5-flash
# LLM_MAX_TOKENS=4096
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Dossier des données (base SQLite, fichiers, profil). Par défaut : ./data
# ICA_DATA_DIR=
